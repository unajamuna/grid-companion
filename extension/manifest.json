{
  "manifest_version": 3,
  "name": "Grid Companion: AI Nudge",
  "short_name": "Grid Companion",
  "version": "0.1.0",
  "description": "A gentle pause before AI chats when California's grid is running on gas or near its peak. Always overridable.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Grid Companion",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://gridcompanion.netlify.app/*"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["nudge-rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
